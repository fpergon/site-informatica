1 7.68872 6.50731 7.68872C6.46386 7.68872 6.37408 7.64826 6.37408 7.53311Z" fill="white" stroke="white"></path><path d="M2.90728 9.22183C2.90728 9.10667 2.99708 9.06614 3.0406 9.06614C3.08397 9.06614 3.17383 9.10653 3.17383 9.22183C3.17383 9.33698 3.08404 9.37744 3.0406 9.37744C2.997 9.37744 2.90728 9.33684 2.90728 9.22183Z" fill="white" stroke="white"></path><path d="M4.64158 9.22183C4.64158 9.10667 4.73137 9.06614 4.77489 9.06614C4.81841 9.06614 4.9082 9.10667 4.9082 9.22183C4.9082 9.33684 4.81848 9.37744 4.77489 9.37744C4.73129 9.37744 4.64158 9.33684 4.64158 9.22183Z" fill="white" stroke="white"></path><path d="M6.37408 9.22183C6.37408 9.10653 6.46394 9.06614 6.50731 9.06614C6.55084 9.06614 6.64062 9.10667 6.64062 9.22183C6.64062 9.33684 6.55091 9.37744 6.50731 9.37744C6.46386 9.37744 6.37408 9.33698 6.37408 9.22183Z" fill="white" stroke="white"></path></svg><div class="text-xs uppercase">gasolineras.FACUA.org</div></a></nav></div></div></div><div id="hero-section" class="text-white bg-center bg-cover bg-hero-section mix-blend-multiply"><div class="px-6 pt-6 pb-12 mx-auto max-w-content md:pt-24"><div class="md:flex md:gap-4"><div class="w-full md:mb-none md:w-1/2"><div class="flex flex-col items-center justify-center text-left md:items-start"><h1 class="w-full font-sans text-3xl font-extrabold text-white md:mb-4 md:text-5xl">Luchamos<br/>contra los abusos</h1><p class="mb-2 md:mb-4">Nos enfrentamos a los fraudes masivos de <strong>bancos</strong>,<!-- --> <strong>eléctricas</strong>, <strong>telefónicas</strong>,<!-- --> <strong>aseguradoras</strong>...<!-- --> </p><p class="mb-4 md:mb-6">Si tienes un problema de consumo, podemos emprender acciones para defenderte y reclamar tu dinero.</p><p class="w-full mb-2 text-left md:mb-4">¡Únete! <!-- -->Ya somos 250.152 socios</p><div class="flex justify-start w-full"><div class="flex flex-col items-start"><div class="flex flex-row gap-4 md:hidden"><a class=" inline-block bg-primary border-solid  border-2  border-primary font-semibold  leading-none !text-white rounded-full hover:!bg-primary-dark hover:border-primary-dark hover:!text-white text-sm py-2 px-4" href="/unirme/">Unirme</a><a class="donacionescentrologueado inline-block bg-primary border-solid  border-2  border-primary font-semibold  leading-none !text-white rounded-full hover:!bg-primary-dark hover:border-primary-dark hover:!text-white text-sm py-2 px-4" href="/donaciones/">Donación</a></div><div class="hidden md:flex md:mt-4 gap-4"><a class=" inline-block bg-primary border-solid  border-2  border-primary font-semibold  leading-none !text-white rounded-full hover:!bg-primary-dark hover:border-primary-dark hover:!text-white text-lg py-4 px-8" href="/unirme/">Unirme a FACUA</a><a class="donacionescentrologueado inline-block bg-primary border-solid  border-2  border-primary font-semibold  leading-none !text-white rounded-full hover:!bg-primary-dark hover:border-primary-dark hover:!text-white text-lg py-4 px-8" href="/donaciones/">Donación</a></div><div class="mt-4 md:mt-16"><div class="flex"></div></div><p class="w-full mb-2 text-sm text-left md:mb-4"><span class="font-bold text-green-600">+ de 100 artistas y periodistas</span> <!-- -->se han unido a FACUA</p></div></div></div></div><div class="hidden w-full md:block md:w-1/2"><div class="grid grid-cols-2 gap-2"><a class=" col-span-1 block border-2 border-primary p-4 hover:bg-primary hover:text-white md:p-8" href="/noticias/"><div class="flex flex-col gap-2"><svg width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18.5625 5.0625V20.25C18.5625 21.6 19.6594 22.7812 21.0938 22.7812C22.4438 22.7812 23.625 21.6844 23.625 20.25V12.6562H18.5625" stroke="white" stroke-width="1.6875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18.5625 5.0625V20.25C18.5625 21.3469 19.2375 22.275 20.25 22.6125V22.7812H6.75H5.90625C4.47187 22.7812 3.375 21.6 3.375 20.25V5.0625H18.5625Z" stroke="white" stroke-width="1.6875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6.75 9.28125H11.8125" stroke="white" stroke-width="1.6875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6.75 12.6562H8.4375" stroke="white" stroke-width="1.6875" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"></path></svg><div><p class="font-bold">Noticias</p><p class="mt-4 text-sm">Infórmate sobre las cuestiones de actualidad que nos afectan como consumidores.</p></div></div></a><a class=" col-span-1 block border-2 border-primary p-4 hover:bg-primary hover:text-white md:p-8" href="/campanas/"><div class="flex flex-col gap-2"><svg width="27" height="27" viewBox="0 0 27 27" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_112_58856)"><path d="M10.9687 8.4375V21.484C10.97 21.6242 10.9359 21.7625 10.8695 21.886C10.8031 22.0095 10.7067 22.1143 10.589 22.1906L9.42887 22.9605C9.31648 23.0356 9.18771 23.0825 9.05339 23.0974C8.91908 23.1123 8.78315 23.0947 8.65704 23.0462C8.53094 22.9976 8.41835 22.9194 8.32874 22.8183C8.23914 22.7171 8.17515 22.5959 8.14215 22.4648L6.74997 16.875" stroke="white" stroke-width="1.6875" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6.75 16.8746C5.63112 16.8746 4.55806 16.4301 3.76689 15.6389C2.97572 14.8478 2.53125 13.7747 2.53125 12.6558C2.53125 11.5369 2.97572 10.4639 3.76689 9.67271C4.55806 8.88154 5.63112 8.43706 6.75 8.43706H10.9688C10.9688 8.43706 16.7168 8.43706 22.2434 3.80699C22.3663 3.70527 22.5155 3.64048 22.6738 3.62016C22.832 3.59983 22.9928 3.62479 23.1374 3.69214C23.2821 3.75949 23.4047 3.86648 23.491 4.00068C23.5773 4.13488 23.6237 4.2908 23.625 4.45035V20.8613C23.6237 21.0208 23.5773 21.1767 23.491 21.311C23.4047 21.4452 23.2821 21.5521 23.1374 21.6195C22.9928 21.6868 22.832 21.7118 22.6738 21.6915C22.5155 21.6711 22.3663 21.6064 22.2434 21.5046C16.7168 16.8746 10.9688 16.8746 10.9688 16.8746H6.75Z" stroke="white" stroke-widt